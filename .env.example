# Mausam Environment Variables (Optional)

# Groq API Key for the intelligent AI Weather Assistant (free at https://console.groq.com)
VITE_GROQ_API_KEY=

# Translation service endpoint & key (optional, defaults to MyMemory public API)
VITE_TRANSLATE_API_URL=https://api.mymemory.translated.net/get
VITE_TRANSLATE_API_KEY=

# OCR API Key for image translation (optional, free key from https://ocr.space)
VITE_OCR_API_KEY=
